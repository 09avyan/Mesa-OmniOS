{
 "headers": [
  {
   "source": "/universe/u.(.*).json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/universe/u.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/((?!universe/).*)",
   "destination": "/index.html"
  }
 ]
}